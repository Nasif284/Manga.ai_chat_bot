# Server Configuration
PORT=8000
FRONTEND_URI=http://localhost:5173

# Database Connection (MongoDB Atlas or Local)
MONGODB_URi=mongodb+srv://<username>:<password>@cluster.mongodb.net/chatbot?retryWrites=true&w=majority

# Authentication (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Media Management (Cloudinary)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_SECRETE_KEY=your_cloudinary_api_secret

# AI Model Credentials (Optional if server proxies AI)
GEMINI_API_KEY=your_gemini_api_key
